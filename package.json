{
  "name": "team-schedule",
  "productName": "Team Schedule",
  "version": "1.0.1",
  "description": "Weekly team schedule (Hebrew / English) that syncs through a shared git repository",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.teamschedule.app",
    "productName": "Team Schedule",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "en-GB",
      "he"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Team Schedule",
      "artifactName": "TeamSchedule-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TeamSchedule-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
